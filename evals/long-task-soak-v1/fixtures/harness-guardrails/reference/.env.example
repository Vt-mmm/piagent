# Copy to .env and fill in. Empty = not set.

# Optional: HTTP port (default 8080)
PORT=8080
# Optional: debug | info | warn | error (default info)
LOG_LEVEL=info

# Required: Postgres
DB_HOST=localhost
# Optional: default 5432
DB_PORT=5432
DB_USER=change-me
DB_PASSWORD=change-me
DB_NAME=kho
# Optional: true | false (default false)
DB_SSL=false

# Required: redis:// or rediss:// URL
REDIS_URL=redis://:change-me@localhost:6379/0

# Required: at least 16 characters
JWT_SECRET=change-me-to-a-long-random-string
# Optional: token lifetime in seconds (default 3600)
JWT_TTL_SECONDS=3600

# Optional: comma-separated allowed origins (default none)
CORS_ORIGINS=http://localhost:5173
