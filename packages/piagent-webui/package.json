{
  "name": "@piagent/webui",
  "version": "0.0.0-private",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:contracts": "node scripts/generate-contracts.mjs --write",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "npm run check:contracts && npm run build:workspace-worker && vite build",
    "benchmark": "node benchmark/benchmark.mjs",
    "benchmark:parity": "node benchmark/parity-benchmark.mjs",
    "build:workspace-worker": "node scripts/build-workspace-worker.mjs"
  },
  "dependencies": {
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "7.0.2",
    "vite": "8.2.4"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
