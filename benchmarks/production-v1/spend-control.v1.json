    "providerFreeEvidence": {
      "requiredBeforeFirstPaidSession": true,
      "requiredLaneIds": ["runtime-conformance-v1", "long-horizon-v1", "webui-parity-v1"],
      "requireCleanCommitAndTreeBinding": true,
      "requireProductionConfigurationBinding": true,
      "requireRunnerAndLaneConfigurationDigests": true
    }
  },
  "enforcement": {
    "runnerConsumesThisArtifact": true,
    "runnerBindsFrozenSeedAndExecution": true,
    "runnerWritesAtomicPrivateStageDiagnostic": true,
    "runnerBlocksProductionResumeWhenStageDiagnosticFails": true,
    "durableStageStateSurvivesMissingPauseMarker": true,
    "completeLedgerFinalizesWithoutProviderPreflight": true,
    "stageDiagnosticArtifact": "stage-diagnostic.json",
    "automaticTerminalOrAbortRules": [
      "dirty-release-source-before-auth-tool-or-provider-preflight",
      "piagent-unresolved-or-outcome-score-at-or-below-floor-via-stop-after-failed-pair",
      "infrastructure-error-or-unknown-provider-attempt-usage-via-runner-abort",
      "candidate-provenance-drift-via-execution-guard"
    ],
    "stageAdvanceRules": [
      "clean-release-source",
      "no-baseline-pass-piagent-fail",
      "no-observed-paired-grade-regression",
      "all-observed-piagent-outcomes-remain-above-the-release-floor",
      "no-model-thinking-or-provider-wire-parity-drift",
      "complete-privacy-safe-causal-context-receipt-with-closed-session-lifecycle",
      "source-bound-provider-free-runtime-long-horizon-and-webui-parity-receipts",
      "exact-subagent-budget-at-most-one-session-per-attempt-and-five-percent-traffic",
      "partial-stage-pooled-fresh-ratio-at-most-1.10-and-every-observed-family-at-most-1.25",
      "no-accepted-usage-completeness-failure",
      "no-infrastructure-retry",
      "no-unknown-provider-attempt-usage"
    ],
    "nonBlockingDiagnostics": [
      "normalized-api-equivalent-text-token-cost",
      "duration",
      "host-load"
    ],
    "operatorRule": "The commands pass this artifact's frozen values explicitly. S0 binds clean-source runtime-conformance, long-horizon, and WebUI-parity receipts before paid work. Every partial paid stage from S12 onward hard-stops when pooled fresh traffic exceeds 1.10, any observed family exceeds 1.25, or exact subagent evidence exceeds one child session per attempt or 5% of candidate traffic. Cost, duration, and host load remain observational. Only the complete S108 ledger may decide the 0.60 upper-95 fresh-token claim."
  },
  "claimBoundary": "Only S108 may be evaluated for the production-v1 0.60 upper-95 fresh-token public-regression claim. S12, S36 and S72 enforce catastrophic fresh-spend and subagent safety ceilings but cannot establish the claim. Duration, host load, and normalized cost are reported but cannot block or support this claim."
