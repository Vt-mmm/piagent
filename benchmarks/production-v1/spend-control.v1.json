    "requiredCategoryCoverage": ["backend", "frontend", "data", "platform", "reliability", "security"],
    "requiredLifecycleCoverage": ["steady-state", "cold-start"],
    "requiredDifficultyCoverage": ["small", "medium", "large"]
  },
  "productionGuards": {
    "subagents": {
      "required": true,
      "maximumSessionsPerAttempt": 1,
      "maximumTrafficShare": 0.05,
      "requireExactAllAttemptEvidence": true,
      "requireExplainedSessionCount": true
