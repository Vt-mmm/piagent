{
  "name": "@piagent/platform",
  "version": "1.0.2",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "description": "Reusable Pi agent platform, project adapters, MCP/tool policy, and coding workflow harness.",
  "homepage": "https://piagent.io.vn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vt-mmm/piagent.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "pi-prompt",
    "agent-harness"
  ],
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    ".gitattributes",
    "adapters/",
    "catalog/",
    "docs/",
    "!docs/journals/",
    "!docs/decisions/",
    "!docs/readiness-assessment.md",
    "docs-site/",
    "evals/",
    "packs/",
    "packages/piagent-core/",
    "schemas/",
    "scripts/",
    "templates/",
    "types/"
  ],
  "bin": {
    "piagent-setup": "scripts/piagent-cli.mjs",
    "piagent-install": "scripts/piagent-cli.mjs",
    "piagent-uninstall": "scripts/piagent-cli.mjs",
    "piagent-init": "scripts/piagent-cli.mjs",
    "piagent-doctor": "scripts/piagent-cli.mjs",
    "piagent-benchmark": "scripts/piagent-cli.mjs",
    "piagent-usage": "scripts/piagent-cli.mjs",
    "piagent-models": "scripts/piagent-cli.mjs",
    "piagent-model-scope": "scripts/piagent-cli.mjs",
    "piagent-mcp": "scripts/piagent-cli.mjs",
    "piagent-subagents": "scripts/piagent-cli.mjs",
    "piagent-capabilities": "scripts/piagent-cli.mjs",
    "piagent-migrate": "scripts/piagent-cli.mjs",
    "piagent-import-instructions": "scripts/piagent-cli.mjs",
    "piagent-auto": "scripts/piagent-cli.mjs"
  },
  "pi": {
    "extensions": [
      "packages/piagent-core/extensions/piagent-guard.ts"
    ],
    "skills": [
      "packages/piagent-core/skills"
    ],
    "prompts": [
      "packages/piagent-core/prompts"
    ],
    "subagents": {
      "agents": [
        "packages/piagent-core/subagents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "typebox": "1.1.38"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify": "bash scripts/verify-local.sh",
    "test": "node --test tests/*.test.mjs",
    "test:policy": "node --test tests/policy-core.test.mjs",
    "test:golden": "node --test tests/golden-enforcement.test.mjs",
    "typecheck": "tsc --noEmit",
    "setup": "bash scripts/setup.sh",
    "bootstrap": "bash scripts/bootstrap-local.sh",
    "install-global": "bash scripts/install-global.sh",
    "init-project": "bash scripts/init-project.sh",
    "doctor": "bash scripts/team-doctor.sh",
    "benchmark": "bash scripts/quality-benchmark.sh",
    "benchmark:redaction": "node scripts/redaction-benchmark.mjs",
    "audit:runtime": "bash scripts/audit-runtime-host.sh",
    "release:identity": "node scripts/verify-release-identity.mjs",
    "vercel:preflight": "node scripts/verify-vercel-link.mjs",
    "smoke": "bash scripts/runtime-policy-smoke.sh",
    "usage": "bash scripts/pi-session-stats.sh",
    "auto": "bash scripts/pi-auto.sh",
    "models": "bash scripts/pi-model-catalog.sh",
    "model-scope": "bash scripts/configure-model-scope.sh",
    "mcp": "bash scripts/configure-mcp.sh",
    "subagents": "bash scripts/configure-subagents.sh",
    "capabilities:check": "node scripts/capability-catalog.mjs catalog --check",
    "capabilities:catalog": "node scripts/capability-catalog.mjs catalog --write",
    "capabilities:doctor": "node scripts/capability-catalog.mjs doctor"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
