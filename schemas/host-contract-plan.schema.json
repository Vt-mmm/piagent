{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piagent.dev/schemas/host-contract-plan.schema.json",
  "title": "Operator-reviewed independent verification plan",
  "description": "Input to piagent approve-verification. Expected results must be reviewed independently of the candidate; this file is not itself authority or evidence.",
  "oneOf": [
    {"$ref": "approved-host-contracts.schema.json#/$defs/plan"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion","plans"],
      "properties": {
        "schemaVersion": {"const": 2},
        "plans": {"type": "array","minItems": 1,"maxItems": 32,"items": {"$ref": "approved-host-contracts.schema.json#/$defs/plan"}}
      }
    },
    {"$ref": "approved-host-contracts.schema.json#/$defs/planV2"},
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion","plans"],
      "properties": {"schemaVersion": {"const": 4},"plans": {"type": "array","minItems": 1,"maxItems": 32,"items": {"$ref": "approved-host-contracts.schema.json#/$defs/planV2"}}}
    }
  ]
}
