{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vt-mmm/piagent/schemas/model-route-decision.schema.json",
  "title": "Pi Agent Model Route Decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "policyVersion", "mappingVersion", "featureHash", "mode", "objective",
    "capabilityBand", "safetyFloor", "fallbackBand", "provider", "modelId", "effort",
    "currentProvider", "currentModelId", "currentEffort", "selectionSource", "confidence",
    "disposition", "reasonCodes", "downgradeSteps", "catalogDigest", "decisionDigest", "enforced"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "model-route-v1" },
    "mappingVersion": { "const": "openai-codex-model-route-map-v1" },
    "featureHash": { "$ref": "#/$defs/hash" },
    "mode": { "enum": ["off", "shadow", "recommend", "auto"] },
    "objective": { "enum": ["intelligence", "balance", "cost"] },
    "capabilityBand": { "enum": ["low", "medium", "high", "ultra", "abstain"] },
    "safetyFloor": { "$ref": "#/$defs/band" },
    "fallbackBand": { "oneOf": [{ "$ref": "#/$defs/band" }, { "type": "null" }] },
    "provider": { "$ref": "#/$defs/nullableName" },
    "modelId": { "$ref": "#/$defs/nullableName" },
    "effort": { "$ref": "#/$defs/nullableName" },
    "currentProvider": { "$ref": "#/$defs/nullableName" },
    "currentModelId": { "$ref": "#/$defs/nullableName" },
    "currentEffort": { "$ref": "#/$defs/nullableName" },
    "selectionSource": { "enum": ["explicit-user-pin", "workspace-default", "global-default", "router-selected", "unknown"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "disposition": { "enum": ["preserved", "shadowed", "recommended", "selected", "unavailable", "abstained"] },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
    "downgradeSteps": { "type": "integer", "minimum": 0, "maximum": 3 },
    "catalogDigest": { "$ref": "#/$defs/hash" },
    "decisionDigest": { "$ref": "#/$defs/hash" },
    "enforced": { "type": "boolean" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "band": { "enum": ["low", "medium", "high", "ultra"] },
    "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,159}$" },
    "nullableName": { "oneOf": [{ "$ref": "#/$defs/name" }, { "type": "null" }] }
  }
}
