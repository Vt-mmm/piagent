{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piagent.dev/schemas/contract-family-library.schema.json",
  "title": "Declarative reusable contract library",
  "description": "Bounded data templates, not executable oracle code. A {$parameter: name} node is replaced with one typed binding, never evaluated or recursively interpreted. Runtime additionally checks unique identities, used references and full expanded contract semantics.",
  "type": "object", "additionalProperties": false, "required": ["schemaVersion", "families"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "families": { "type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "domain", "description", "parameters", "template"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9:._-]{0,79}$" },
        "version": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "domain": { "enum": ["pure-function", "temporal-input", "configuration-precedence", "stateful-recovery"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "parameters": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$" },
          "additionalProperties": { "enum": ["export", "string", "number", "value"] } },
        "template": { "type": "object", "additionalProperties": false, "required": ["exportName", "checks"], "properties": {
          "exportName": { "oneOf": [ { "type": "string", "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]{0,127}$" }, { "$ref": "#/$defs/reference" } ] },
          "checks": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "type": "object" } }
        } }
      }
    } }
  },
  "$defs": { "reference": { "type": "object", "additionalProperties": false, "required": ["$parameter"],
    "properties": { "$parameter": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$" } } } }
}
