{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vt-mmm/piagent/schemas/failure-classification.schema.json",
  "title": "Pi Agent Failure Classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "evidenceDigest", "category", "ownership", "retryable", "sourceMutationPermission", "confidence", "reasonCodes", "authorizesSourceMutation", "outputRef"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "failure-policy-v1" },
    "evidenceDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "category": { "enum": ["passed", "compile-typecheck", "test-assertion", "lint-format", "dependency-config", "environment", "provider-network", "permission-policy", "scope-protected-path", "flaky-infrastructure", "unknown"] },
    "ownership": { "enum": ["none", "source", "test-expectation", "dependency", "environment", "provider", "permission", "policy", "scope", "infrastructure", "unknown"] },
    "retryable": { "type": "boolean" },
    "sourceMutationPermission": { "enum": ["eligible-in-scope", "conditional", "forbidden"] },
    "confidence": { "enum": ["low", "medium", "high"] },
    "reasonCodes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "failure-evidence.schema.json#/$defs/reason" } },
    "authorizesSourceMutation": { "const": false },
    "outputRef": { "$ref": "failure-evidence.schema.json#/$defs/outputRef" }
  },
  "allOf": [
    { "if": { "properties": { "category": { "enum": ["environment", "provider-network", "permission-policy", "scope-protected-path", "flaky-infrastructure", "unknown", "passed"] } } }, "then": { "properties": { "sourceMutationPermission": { "const": "forbidden" } } } }
  ]
}
