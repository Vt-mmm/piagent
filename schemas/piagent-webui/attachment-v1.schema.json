{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/attachment-v1.schema.json",
  "title": "Piagent WebUI bounded attachment staging v1",
  "oneOf": [
    { "$ref": "#/$defs/stageCommand" },
    { "$ref": "#/$defs/stageReceipt" },
    { "$ref": "#/$defs/discardCommand" },
    { "$ref": "#/$defs/discardReceipt" }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "runtimeInstanceId", "sessionRef", "taskId", "taskRunId", "agentOperationId", "toolCallId"],
      "properties": {
        "projectRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "runtimeInstanceId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "sessionRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "taskId": { "$ref": "common-v1.schema.json#/$defs/nullablePublicId" },
        "taskRunId": { "$ref": "common-v1.schema.json#/$defs/nullablePublicId" },
        "agentOperationId": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "toolCallId": { "type": "null" }
      },
      "allOf": [
        {
          "if": { "properties": { "taskRunId": { "type": "string" } }, "required": ["taskRunId"] },
          "then": { "properties": { "taskId": { "$ref": "common-v1.schema.json#/$defs/publicId" } } }
        }
      ]
    },
    "stageFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "declaredMimeType", "dataBase64"],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^\\u0000-\\u001F\\u007F/\\\\]*$"
        },
        "declaredMimeType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp",
            "image/bmp",
            "text/plain",
            "text/markdown",
            "application/json"
          ]
        },
        "dataBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "stageCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "commandId", "idempotencyKey", "requestedAt", "expiresAt", "identity", "expectedRuntimeRevision", "messageRequestId", "file"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-attachment-v1" },
        "messageType": { "const": "stage-command" },
        "commandId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "requestedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "identity": { "$ref": "#/$defs/identity" },
        "expectedRuntimeRevision": { "$ref": "common-v1.schema.json#/$defs/revisionToken" },
        "messageRequestId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "file": { "$ref": "#/$defs/stageFile" }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachmentRef", "messageRequestId", "displayName", "kind", "mimeType", "sizeBytes", "expiresAt"],
      "properties": {
        "attachmentRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "messageRequestId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001F\\u007F/\\\\]*$"
        },
        "kind": { "enum": ["file", "image"] },
        "mimeType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+*-]+$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "expiresAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
      }
    },
    "stageError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "$ref": "common-v1.schema.json#/$defs/reasonCode" },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"
        },
        "retryable": { "type": "boolean" }
      }
    },
    "stageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "commandId", "identity", "phase", "resultCode", "requestedAt", "settledAt", "deduplicated", "attachment", "error"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-attachment-v1" },
        "messageType": { "const": "stage-receipt" },
        "commandId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "identity": { "$ref": "#/$defs/identity" },
        "phase": { "enum": ["settled", "rejected"] },
        "resultCode": {
          "enum": [
            "staged",
            "invalid-command",
            "identity-mismatch",
            "stale-revision",
            "expired",
            "unsupported-type",
            "invalid-content",
            "limit-exceeded",
            "storage-unavailable",
            "idempotency-payload-mismatch",
            "capability-unavailable"
          ]
        },
        "requestedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "settledAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "deduplicated": { "type": "boolean" },
        "attachment": {
          "anyOf": [
            { "$ref": "#/$defs/attachment" },
            { "type": "null" }
          ]
        },
        "error": {
          "anyOf": [
            { "$ref": "#/$defs/stageError" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "phase": { "const": "settled" } }, "required": ["phase"] },
          "then": {
            "properties": {
              "resultCode": { "const": "staged" },
              "attachment": { "$ref": "#/$defs/attachment" },
              "error": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "phase": { "const": "rejected" } }, "required": ["phase"] },
          "then": {
            "properties": {
              "resultCode": {
                "enum": [
                  "invalid-command",
                  "identity-mismatch",
                  "stale-revision",
                  "expired",
                  "unsupported-type",
                  "invalid-content",
                  "limit-exceeded",
                  "storage-unavailable",
                  "idempotency-payload-mismatch",
                  "capability-unavailable"
                ]
              },
              "attachment": { "type": "null" },
              "error": { "$ref": "#/$defs/stageError" }
            }
          }
        }
      ]
    },
    "discardCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "commandId", "idempotencyKey", "requestedAt", "expiresAt", "identity", "expectedRuntimeRevision", "messageRequestId", "attachmentRef"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-attachment-v1" },
        "messageType": { "const": "discard-command" },
        "commandId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "idempotencyKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "requestedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "expiresAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "identity": { "$ref": "#/$defs/identity" },
        "expectedRuntimeRevision": { "$ref": "common-v1.schema.json#/$defs/revisionToken" },
        "messageRequestId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "attachmentRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" }
      }
    },
    "discardReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "commandId", "identity", "phase", "resultCode", "requestedAt", "settledAt", "deduplicated", "attachmentRef", "error"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-attachment-v1" },
        "messageType": { "const": "discard-receipt" },
        "commandId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "identity": { "$ref": "#/$defs/identity" },
        "phase": { "enum": ["settled", "rejected"] },
        "resultCode": { "enum": ["discarded", "invalid-command", "identity-mismatch", "stale-revision", "expired", "attachment-unavailable", "idempotency-payload-mismatch", "capability-unavailable"] },
        "requestedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "settledAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "deduplicated": { "type": "boolean" },
        "attachmentRef": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "error": {
          "anyOf": [
            { "$ref": "#/$defs/stageError" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "phase": { "const": "settled" } }, "required": ["phase"] },
          "then": { "properties": { "resultCode": { "const": "discarded" }, "attachmentRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" }, "error": { "type": "null" } } }
        },
        {
          "if": { "properties": { "phase": { "const": "rejected" } }, "required": ["phase"] },
          "then": {
            "properties": {
              "resultCode": { "enum": ["invalid-command", "identity-mismatch", "stale-revision", "expired", "attachment-unavailable", "idempotency-payload-mismatch", "capability-unavailable"] },
              "attachmentRef": { "type": "null" },
              "error": { "$ref": "#/$defs/stageError" }
            }
          }
        }
      ]
    }
  }
}
