{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/transcript-v1.schema.json",
  "title": "Piagent WebUI bounded transcript projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "generatedAt",
    "identity",
    "revision",
    "eventCursor",
    "state",
    "items",
    "page",
    "reasonCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "const": "piagent-webui-transcript-v1" },
    "generatedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "identity": { "$ref": "#/$defs/identity" },
    "revision": { "$ref": "common-v1.schema.json#/$defs/domainRevision" },
    "eventCursor": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
    "state": { "enum": ["ready", "unavailable"] },
    "items": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/transcriptItem" }
    },
    "page": { "$ref": "#/$defs/page" },
    "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
      "then": { "properties": { "reasonCode": { "type": "null" } } }
    },
    {
      "if": { "properties": { "state": { "const": "unavailable" } }, "required": ["state"] },
      "then": {
        "properties": {
          "items": { "type": "array", "maxItems": 0 },
          "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" },
          "page": {
            "type": "object",
            "properties": {
              "nextBeforeCursor": { "type": "null" },
              "hasOlder": { "const": false }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectRef", "runtimeInstanceId", "sessionRef", "taskId", "taskRunId", "agentOperationId", "toolCallId"],
      "properties": {
        "projectRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "runtimeInstanceId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "sessionRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "taskId": { "$ref": "common-v1.schema.json#/$defs/nullablePublicId" },
        "taskRunId": { "$ref": "common-v1.schema.json#/$defs/nullablePublicId" },
        "agentOperationId": { "type": "null" },
        "toolCallId": { "type": "null" }
      },
      "allOf": [
        {
          "if": { "properties": { "taskRunId": { "type": "string" } }, "required": ["taskRunId"] },
          "then": { "properties": { "taskId": { "$ref": "common-v1.schema.json#/$defs/publicId" } } }
        }
      ]
    },
    "nullableCount": {
      "anyOf": [
        { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        { "type": "null" }
      ]
    },
    "safeTranscriptText": {
      "type": "string",
      "maxLength": 16384,
      "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]*$"
    },
    "nullableSafeTranscriptText": {
      "anyOf": [
        { "$ref": "#/$defs/safeTranscriptText" },
        { "type": "null" }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "text", "textChars", "digest", "truncated", "redacted", "imageCount", "reasonCode"],
      "properties": {
        "state": { "enum": ["available", "redacted", "unavailable"] },
        "text": { "$ref": "#/$defs/nullableSafeTranscriptText" },
        "textChars": { "$ref": "#/$defs/nullableCount" },
        "digest": {
          "anyOf": [
            { "$ref": "common-v1.schema.json#/$defs/digest" },
            { "type": "null" }
          ]
        },
        "truncated": { "type": "boolean" },
        "redacted": { "type": "boolean" },
        "imageCount": { "type": "integer", "minimum": 0, "maximum": 32 },
        "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] },
          "then": {
            "properties": {
              "text": { "$ref": "#/$defs/safeTranscriptText" },
              "textChars": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
              "digest": { "$ref": "common-v1.schema.json#/$defs/digest" },
              "redacted": { "const": false },
              "reasonCode": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "redacted" } }, "required": ["state"] },
          "then": {
            "properties": {
              "text": { "$ref": "#/$defs/safeTranscriptText" },
              "textChars": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
              "digest": { "$ref": "common-v1.schema.json#/$defs/digest" },
              "redacted": { "const": true },
              "reasonCode": { "const": "sensitive-values-redacted" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "unavailable" } }, "required": ["state"] },
          "then": {
            "properties": {
              "text": { "type": "null" },
              "textChars": { "type": "null" },
              "digest": { "type": "null" },
              "truncated": { "const": false },
              "redacted": { "const": false },
              "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" }
            }
          }
        }
      ]
    },
    "harnessProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase"],
      "properties": {
        "phase": { "enum": ["plan", "verify", "review", "final", "objection", "answer", "claims", "rejudge", "dispute", "continue"] },
        "outcome": { "enum": ["no_change", "interrupted", "disputed", "blocking_open", "unverified", "review_unavailable", "unreviewed", "clean"] },
        "role": { "enum": ["scout", "research", "verify", "review"] },
        "by": { "enum": ["main", "harness"] },
        "disputes": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "unchanged": { "const": true },
        "issues": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "detail"],
            "properties": {
              "kind": { "enum": ["wrong_premise", "conflicts_with_request", "ambiguous", "out_of_scope"] },
              "detail": { "type": "string", "maxLength": 400 }
            }
          }
        },
        "claims": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim"],
            "properties": { "claim": { "type": "string", "maxLength": 500 } }
          }
        },
        "loop": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxLoops": { "type": "integer", "minimum": 0, "maximum": 3 },
        "verified": { "type": "boolean" },
        "reviewed": { "type": "boolean" },
        "blockingOpen": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "planOpen": { "type": "integer", "minimum": 1, "maximum": 30 },
        "planDone": { "type": "integer", "minimum": 0, "maximum": 30 },
        "planSteps": { "type": "integer", "minimum": 1, "maximum": 30 },
        "round": { "type": "integer", "minimum": 1, "maximum": 30 },
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 30 },
        "idle": { "type": "integer", "minimum": 1, "maximum": 2 },
        "planSkipped": { "const": true },
        "verifyPolicy": { "enum": ["off", "suggest", "require"] },
        "reviewPolicy": { "enum": ["off", "suggest", "require"] },
        "reviewUnavailable": { "enum": ["too_large", "not_git", "limit", "failed"] },
        "findings": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["severity", "file", "line", "issue"],
            "properties": {
              "severity": { "enum": ["blocking", "major", "minor"] },
              "file": { "type": "string", "maxLength": 300 },
              "line": { "type": ["integer", "null"], "minimum": 1 },
              "issue": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    "turnEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "planSteps", "planDone", "rounds"],
      "properties": {
        "state": { "enum": ["done", "midway", "failed", "cancelled"] },
        "planSteps": { "type": "integer", "minimum": 0, "maximum": 30 },
        "planDone": { "type": "integer", "minimum": 0, "maximum": 30 },
        "planDeferred": { "type": "integer", "minimum": 1, "maximum": 30 },
        "rounds": { "type": "integer", "minimum": 0, "maximum": 30 },
        "reason": { "enum": ["idle", "limit", "policy"] },
        "role": { "enum": ["main", "scout", "research", "verify", "review"] },
        "code": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" }
      }
    },
    "companyFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "reasonCode", "code", "requestRef", "local"],
      "properties": {
        "role": { "enum": ["main", "scout", "research", "verify", "review"] },
        "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" },
        "code": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_:.-]{0,79}$" },
        "requestRef": { "anyOf": [{ "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }, { "type": "null" }] },
        "local": { "type": "boolean" }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["toolCallRef", "toolName", "state"],
      "properties": {
        "toolCallRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@~-]{0,79}$"
        },
        "state": { "enum": ["requested", "completed", "failed", "unknown"] },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "detail"],
          "properties": {
            "kind": { "enum": ["read", "write", "edit", "command", "search", "list", "web-search", "web-fetch", "subagent", "network", "git", "plan", "other"] },
            "target": { "anyOf": [{ "type": "string", "maxLength": 400 }, { "type": "null" }] },
            "detail": { "anyOf": [{ "type": "string", "maxLength": 400 }, { "type": "null" }] }
          }
        },
        "change": {
          "type": "object",
          "additionalProperties": false,
          "required": ["added", "removed", "preview", "truncated"],
          "properties": {
            "added": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "removed": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "preview": { "type": "string", "maxLength": 6000 },
            "truncated": { "type": "boolean" }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "truncated", "isError"],
          "properties": {
            "text": { "type": "string", "maxLength": 4000 },
            "truncated": { "type": "boolean" },
            "isError": { "type": "boolean" }
          }
        },
        "failure": { "$ref": "#/$defs/companyFailure" }
      }
    },
    "transcriptItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageRef",
        "parentMessageRef",
        "role",
        "recordedAt",
        "agentOperationId",
        "turnIndex",
        "content",
        "toolCalls"
      ],
      "properties": {
        "messageRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "parentMessageRef": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "role": { "enum": ["user", "assistant", "tool-result", "custom"] },
        "recordedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "agentOperationId": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "messageRequestId": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "turnIndex": { "$ref": "#/$defs/nullableCount" },
        "content": { "$ref": "#/$defs/content" },
        "attachments": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/attachmentSummary" }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["inputTokens", "outputTokens", "cacheReadTokens", "cacheWriteTokens", "totalTokens"],
          "properties": {
            "inputTokens": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
            "outputTokens": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
            "cacheReadTokens": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
            "cacheWriteTokens": { "type": "integer", "minimum": 0, "maximum": 10000000000 },
            "totalTokens": { "type": "integer", "minimum": 0, "maximum": 10000000000 }
          }
        },
        "model": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Za-z0-9._:@/-]{1,120}$" },
        "failure": { "$ref": "#/$defs/companyFailure" },
        "process": { "$ref": "#/$defs/harnessProcess" },
        "turnEnd": { "$ref": "#/$defs/turnEnd" },
        "toolCalls": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolCall" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "turnIndex": { "type": "integer" } }, "required": ["turnIndex"] },
          "then": { "properties": { "agentOperationId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" } } }
        },
        {
          "if": { "properties": { "role": { "const": "tool-result" } }, "required": ["role"] },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "properties": {
                  "state": { "const": "unavailable" },
                  "reasonCode": { "const": "tool-output-in-activity-preview" }
                }
              },
              "toolCalls": { "type": "array", "minItems": 1, "maxItems": 1 }
            }
          }
        }
      ]
    },
    "attachmentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "kind", "mimeType", "truncated"],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001F\\u007F/\\\\]*$"
        },
        "kind": { "enum": ["file", "image", "document"] },
        "mimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
        },
        "truncated": { "type": "boolean" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["beforeCursor", "nextBeforeCursor", "hasOlder", "limit", "truncated"],
      "properties": {
        "beforeCursor": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "nextBeforeCursor": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "hasOlder": { "type": "boolean" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
        "truncated": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "hasOlder": { "const": false } }, "required": ["hasOlder"] },
          "then": { "properties": { "nextBeforeCursor": { "type": "null" } } }
        },
        {
          "if": { "properties": { "hasOlder": { "const": true } }, "required": ["hasOlder"] },
          "then": { "properties": { "nextBeforeCursor": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" } } }
        }
      ]
    }
  }
}
