{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/session-live-state-v1.schema.json",
  "title": "Piagent WebUI canonical volatile session operation state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "generatedAt", "gatewayInstanceRef", "eventSequence", "state", "operations", "settlements", "reasonCode"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "const": "piagent-session-live-state-v1" },
    "generatedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "gatewayInstanceRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
    "eventSequence": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "state": { "enum": ["ready", "unavailable"] },
    "operations": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/currentOperation" }
    },
    "settlements": {
      "description": "Bounded, Gateway-epoch-local non-success terminal operation outcomes retained for Activity reconciliation.",
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/terminalSettlement" }
    },
    "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
      "then": { "properties": { "reasonCode": { "type": "null" } } },
      "else": {
        "properties": {
          "operations": { "type": "array", "maxItems": 0 },
          "settlements": { "type": "array", "maxItems": 0 },
          "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" }
        }
      }
    }
  ],
  "$defs": {
    "currentOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionRef", "operationRef", "state", "abortable"],
      "properties": {
        "sessionRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "operationRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "state": { "enum": ["running", "waiting-approval", "settling"] },
        "abortable": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "settling" } }, "required": ["state"] },
          "then": { "properties": { "abortable": { "const": false } } },
          "else": { "properties": { "abortable": { "const": true } } }
        }
      ]
    },
    "terminalSettlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionRef", "operationRef", "settlement", "reasonCode", "settledAt", "sequence"],
      "properties": {
        "sessionRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "operationRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "settlement": { "enum": ["blocked", "aborted", "error", "unknown"] },
        "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" },
        "settledAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    }
  }
}
