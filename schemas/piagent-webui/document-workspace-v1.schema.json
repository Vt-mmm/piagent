{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/document-workspace-v1.schema.json",
  "title": "Piagent WebUI bounded document workspace v1",
  "oneOf": [
    { "$ref": "#/$defs/listing" },
    { "$ref": "#/$defs/document" }
  ],
  "$defs": {
    "displayText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
    },
    "nullableDisplayText": {
      "anyOf": [
        { "$ref": "#/$defs/displayText" },
        { "type": "null" }
      ]
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootRef", "path", "source", "documentCount"],
      "properties": {
        "rootRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "path": { "$ref": "#/$defs/displayText" },
        "source": { "enum": ["project", "profile", "environment"] },
        "documentCount": { "type": "integer", "minimum": 0, "maximum": 2000 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentRef", "rootRef", "name", "relativePath", "extension", "sizeBytes", "modifiedAt"],
      "properties": {
        "documentRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "rootRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "name": { "$ref": "#/$defs/displayText" },
        "relativePath": { "$ref": "#/$defs/displayText" },
        "extension": {
          "enum": ["md", "markdown", "txt", "text", "csv", "tsv", "json", "yaml", "yml", "pdf", "docx"]
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 12582912 },
        "modifiedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" }
      }
    },
    "listing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "generatedAt", "state", "roots", "documents", "truncated", "reasonCode"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-document-workspace-v1" },
        "messageType": { "const": "listing" },
        "generatedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "state": { "enum": ["ready", "unavailable"] },
        "roots": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/root" }
        },
        "documents": {
          "type": "array",
          "maxItems": 2000,
          "items": { "$ref": "#/$defs/entry" }
        },
        "truncated": { "type": "boolean" },
        "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "unavailable" } }, "required": ["state"] },
          "then": {
            "properties": {
              "roots": { "type": "array", "maxItems": 0 },
              "documents": { "type": "array", "maxItems": 0 },
              "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": {
            "properties": {
              "roots": { "type": "array", "minItems": 1 },
              "reasonCode": { "type": "null" }
            }
          }
        }
      ]
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "version", "messageType", "generatedAt", "documentRef", "state", "name", "relativePath", "rootRef", "format", "text", "sizeBytes", "truncated", "redacted", "reasonCode"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "version": { "const": "piagent-webui-document-workspace-v1" },
        "messageType": { "const": "document" },
        "generatedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "documentRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "state": { "enum": ["ready", "unavailable"] },
        "name": { "$ref": "#/$defs/nullableDisplayText" },
        "relativePath": { "$ref": "#/$defs/nullableDisplayText" },
        "rootRef": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" },
        "format": { "enum": ["text", "docx", "pdf", null] },
        "text": {
          "anyOf": [
            { "type": "string", "maxLength": 400000 },
            { "type": "null" }
          ]
        },
        "sizeBytes": {
          "anyOf": [
            { "type": "integer", "minimum": 1, "maximum": 12582912 },
            { "type": "null" }
          ]
        },
        "truncated": { "type": "boolean" },
        "redacted": { "type": "boolean" },
        "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
          "then": {
            "properties": {
              "name": { "$ref": "#/$defs/displayText" },
              "relativePath": { "$ref": "#/$defs/displayText" },
              "rootRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
              "format": { "enum": ["text", "docx", "pdf"] },
              "text": { "type": "string", "maxLength": 400000 },
              "reasonCode": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "unavailable" } }, "required": ["state"] },
          "then": {
            "properties": {
              "text": { "type": "null" },
              "format": { "type": "null" },
              "truncated": { "const": false },
              "redacted": { "const": false },
              "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" }
            }
          }
        }
      ]
    }
  }
}
