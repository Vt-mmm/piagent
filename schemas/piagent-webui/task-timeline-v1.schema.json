{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/task-timeline-v1.schema.json",
  "title": "Piagent WebUI durable task recovery timeline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "generatedAt", "identity", "runRef", "state", "timelineRevision", "continuity", "events", "page", "warnings", "health"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "const": "piagent-webui-task-timeline-v1" },
    "generatedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
    "identity": { "$ref": "common-v1.schema.json#/$defs/identity" },
    "runRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
    "state": { "enum": ["ready", "unavailable"] },
    "timelineRevision": { "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken" },
    "continuity": { "$ref": "#/$defs/continuity" },
    "events": { "type": "array", "maxItems": 300, "items": { "$ref": "#/$defs/event" } },
    "page": { "$ref": "#/$defs/page" },
    "warnings": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/warning" } },
    "health": { "$ref": "common-v1.schema.json#/$defs/health" }
  },
  "allOf": [
    { "properties": { "identity": { "type": "object", "properties": { "taskId": { "$ref": "common-v1.schema.json#/$defs/publicId" }, "taskRunId": { "$ref": "common-v1.schema.json#/$defs/publicId" }, "agentOperationId": { "type": "null" }, "toolCallId": { "type": "null" } } } } },
    {
      "if": { "properties": { "state": { "const": "ready" } }, "required": ["state"] },
      "then": { "properties": { "timelineRevision": { "$ref": "common-v1.schema.json#/$defs/revisionToken" }, "health": { "type": "object", "properties": { "state": { "enum": ["ok", "degraded"] } } } } },
      "else": { "properties": { "timelineRevision": { "type": "null" }, "events": { "type": "array", "maxItems": 0 },
        "continuity": { "type": "object", "properties": { "crashEvidence": { "const": "unknown" }, "recoveryDecision": { "const": "unknown" }, "latestCheckpointRef": { "type": "null" }, "reasonCode": { "$ref": "common-v1.schema.json#/$defs/reasonCode" } } },
        "page": { "type": "object", "properties": { "total": { "const": 0 }, "returned": { "const": 0 }, "truncated": { "const": false } } },
        "health": { "type": "object", "properties": { "state": { "enum": ["unavailable", "error"] } } } } }
    }
  ],
  "$defs": {
    "continuity": { "type": "object", "additionalProperties": false, "required": ["crashEvidence", "recoveryDecision", "latestCheckpointRef", "reasonCode"],
      "properties": { "crashEvidence": { "enum": ["possible-interruption", "unknown"] }, "recoveryDecision": { "enum": ["resume", "retry", "paused", "terminal", "blocked", "unknown"] },
        "latestCheckpointRef": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" }, "reasonCode": { "$ref": "common-v1.schema.json#/$defs/nullableReasonCode" } } },
    "event": { "type": "object", "additionalProperties": false, "required": ["eventRef", "evidenceRef", "sequence", "recordedAt", "kind", "state", "title", "detail", "checkpointRef"],
      "properties": { "eventRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" }, "evidenceRef": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 2147483647 }, "recordedAt": { "$ref": "common-v1.schema.json#/$defs/timestamp" },
        "kind": { "enum": ["task-written", "session-bound", "checkpoint", "pause-requested", "paused", "pause-cancelled", "resume-requested", "resumed", "resume-rejected", "stop-requested", "stop-settled", "continuation", "digest-migrated"] },
        "state": { "enum": ["observed", "requested", "settled", "failed", "unknown"] }, "title": { "$ref": "common-v1.schema.json#/$defs/nonEmptyDisplayText" },
        "detail": { "$ref": "common-v1.schema.json#/$defs/nullableDisplayText" }, "checkpointRef": { "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef" } } },
    "page": { "type": "object", "additionalProperties": false, "required": ["total", "returned", "truncated"], "properties": {
      "total": { "type": "integer", "minimum": 0, "maximum": 100000 }, "returned": { "type": "integer", "minimum": 0, "maximum": 300 }, "truncated": { "type": "boolean" } } },
    "warning": { "type": "object", "additionalProperties": false, "required": ["code", "count", "message"], "properties": {
      "code": { "enum": ["journal-corrupt", "recoverable-tail", "timeline-truncated", "journal-input-truncated", "crash-not-observed"] }, "count": { "type": "integer", "minimum": 1, "maximum": 100000 },
      "message": { "$ref": "common-v1.schema.json#/$defs/nonEmptyDisplayText" } } }
  }
}
