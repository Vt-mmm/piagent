            "pause-cancelled",
            "resume-rejected",
            "resumed-not-dispatched",
            "held",
            "updated",
            "deleted",
            "dispatch-requested",
            "dispatch-observed",
            "dispatch-rejected",
            "dispatch-unknown",
            "changed",
            "unchanged",
            "effect-unknown",
            "reviewed",
            "unreviewed",
            "staged",
            "unstaged",
            "reverted",
            "opened",
            "summary-generated",
            "stale-revision",
            "identity-mismatch",
            "capability-unavailable",
            "replay",
            "idempotency-payload-mismatch",
            "terminal-task",
            "expired",
            "invalid-command",
            "resync-required"
          ]
        },
        "requestedAt": {
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "settledAt": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
