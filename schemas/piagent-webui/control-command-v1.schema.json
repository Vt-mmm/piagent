                "settlement-unknown",
                "audit-unavailable",
                "pause-unconfirmed",
                "dispatch-unknown",
                "effect-unknown",
                "resumed-not-dispatched"
              ]
            },
            "settledAt": {
              "$ref": "common-v1.schema.json#/$defs/timestamp"
            },
            "settlementEvidenceRef": { "type": "null" },
            "error": { "$ref": "#/$defs/controlError" }
          },
          "required": ["phase", "resultCode", "settledAt", "settlementEvidenceRef", "error"]
