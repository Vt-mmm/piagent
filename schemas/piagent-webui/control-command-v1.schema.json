        "observedRevisionsBefore": {
          "$ref": "common-v1.schema.json#/$defs/domainRevision"
        },
        "observedRevisionsAfter": {
          "$ref": "common-v1.schema.json#/$defs/domainRevision"
        },
        "deduplicated": {
          "type": "boolean"
        },
        "auditRef": {
          "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef"
        },
        "settlementEvidenceRef": {
          "$ref": "common-v1.schema.json#/$defs/nullableOpaqueRef"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/controlError"
            },
            {
              "type": "null"
            }
          ]
        }
