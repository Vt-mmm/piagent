    "genericRejectedResultCode": {
      "enum": [
        "stale-revision",
        "identity-mismatch",
        "capability-unavailable",
        "replay",
        "idempotency-payload-mismatch",
        "terminal-task",
        "expired",
        "invalid-command",
        "resync-required"
      ]
    },
    "receiptActionResultBinding": {
