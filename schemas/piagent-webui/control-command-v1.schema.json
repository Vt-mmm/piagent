              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "resultCode": { "const": "dispatch-observed" } },
            "required": ["resultCode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "object",
                "properties": {
                  "agentOperationId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "resultCode": { "const": "replay" }
            },
            "required": ["resultCode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "deduplicated": { "const": true }
            }
          }
        }
      ]
