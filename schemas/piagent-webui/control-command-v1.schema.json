{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piagent.io.vn/schemas/piagent-webui/control-command-v1.schema.json",
  "title": "Piagent WebUI control command and receipt v1",
  "oneOf": [
    {
      "$ref": "#/$defs/command"
    },
    {
      "$ref": "#/$defs/receipt"
    }
  ],
  "$defs": {
    "action": {
      "enum": [
        "chat.send",
        "queue.update",
        "queue.delete",
        "queue.dispatch",
        "lifecycle.stop",
        "lifecycle.pause",
        "lifecycle.resume",
        "lifecycle.resume-and-continue",
        "session-options.set-model",
        "session-options.set-thinking",
        "review.mark",
        "source.stage",
        "source.unstage",
        "source.revert",
        "source.open-in-vscode",
        "commit-summary.generate"
      ]
    },
    "capabilityScope": {
      "enum": [
        "control.chat",
        "control.lifecycle",
        "control.resumeAndContinue",
        "control.sessionOptions",
        "reviewActions"
      ]
    },
    "expectedRevisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtimeRevision",
        "taskRevision",
        "controlRevision",
        "workspaceRevision",
        "indexRevision",
        "approvalRevision",
        "sessionOptionRevision",
        "queueRevision",
        "workspacePreimage",
        "indexPreimage",
        "patchPreimage"
      ],
      "properties": {
        "runtimeRevision": {
          "$ref": "common-v1.schema.json#/$defs/revisionToken"
        },
        "taskRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "controlRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "workspaceRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "indexRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "approvalRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "sessionOptionRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "queueRevision": {
          "$ref": "common-v1.schema.json#/$defs/nullableRevisionToken"
        },
        "workspacePreimage": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/workingTreeDigest"
            },
            {
              "type": "null"
            }
          ]
        },
        "indexPreimage": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "patchPreimage": {
          "anyOf": [
            {
              "$ref": "common-v1.schema.json#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "messageContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "messageRequestId",
        "capabilityAction",
        "delivery",
        "text",
        "attachmentRefs",
        "contentDigest"
      ],
      "properties": {
        "messageRequestId": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "capabilityAction": {
          "enum": ["send", "hold", "interruptAndSend"]
        },
        "delivery": {
          "enum": [
            "new-operation",
            "steer",
            "follow-up",
            "hold"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[^\\u0000]*$"
        },
        "attachmentRefs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/opaqueRef"
          }
        },
        "contentDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "delivery": { "enum": ["new-operation", "follow-up"] } },
            "required": ["delivery"]
          },
          "then": {
            "type": "object",
            "properties": { "capabilityAction": { "const": "send" } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "delivery": { "const": "hold" } },
            "required": ["delivery"]
          },
          "then": {
            "type": "object",
            "properties": { "capabilityAction": { "const": "hold" } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "delivery": { "const": "steer" } },
            "required": ["delivery"]
          },
          "then": {
            "type": "object",
            "properties": { "capabilityAction": { "const": "interruptAndSend" } }
          }
        }
      ]
    },
    "queueUpdatePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueItemRef",
        "text",
        "attachmentRefs",
        "contentDigest"
      ],
      "properties": {
        "queueItemRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "pattern": "^[^\\u0000]*$"
        },
        "attachmentRefs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/opaqueRef"
          }
        },
        "contentDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        }
      }
    },
    "queueDeletePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueItemRef"
      ],
      "properties": {
        "queueItemRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        }
      }
    },
    "queueDispatchPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queueItemRef",
        "messageRequestId"
      ],
      "properties": {
        "queueItemRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "messageRequestId": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        }
      }
    },
    "stopPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestedScope"
      ],
      "properties": {
        "requestedScope": {
          "const": "current-agent-operation"
        }
      }
    },
    "pausePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "safePointPolicy"
      ],
      "properties": {
        "safePointPolicy": {
          "const": "after-current-atomic-unit"
        }
      }
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 0
    },
    "modelPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef",
        "effectScopeAcknowledged"
      ],
      "properties": {
        "modelRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "effectScopeAcknowledged": {
          "enum": [
            "session",
            "session-and-user-default"
          ]
        }
      }
    },
    "thinkingPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thinkingLevel",
        "effectScopeAcknowledged"
      ],
      "properties": {
        "thinkingLevel": {
          "enum": [
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "effectScopeAcknowledged": {
          "enum": [
            "session",
            "session-and-user-default"
          ]
        }
      }
    },
    "reviewMarkPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view",
        "fileRef",
        "diffRef",
        "reviewState",
        "contentDigest"
      ],
      "properties": {
        "view": {
          "$ref": "source-change-v1.schema.json#/$defs/view"
        },
        "fileRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "diffRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "reviewState": {
          "enum": [
            "reviewed",
            "unreviewed"
          ]
        },
        "contentDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        }
      }
    },
    "sourceMutationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileRef",
        "hunkRefs",
        "contentDigest"
      ],
      "properties": {
        "fileRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "hunkRefs": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/opaqueRef"
          }
        },
        "contentDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        }
      }
    },
    "revertPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileRef",
        "hunkRefs",
        "previewRef",
        "confirmedPreviewDigest",
        "contentDigest"
      ],
      "properties": {
        "fileRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "hunkRefs": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common-v1.schema.json#/$defs/opaqueRef"
          }
        },
        "previewRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "confirmedPreviewDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        },
        "contentDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        }
      }
    },
    "openPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileRef",
        "line",
        "column"
      ],
      "properties": {
        "fileRef": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000000
        },
        "column": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "column": { "type": "integer" } },
            "required": ["column"]
          },
          "then": {
            "properties": { "line": { "type": "integer" } }
          }
        }
      ]
    },
    "commitSummaryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "modelTurnAcknowledged"
      ],
      "properties": {
        "mode": {
          "enum": [
            "deterministic",
            "model"
          ]
        },
        "modelTurnAcknowledged": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "model"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "modelTurnAcknowledged": {
                "const": true
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "deterministic"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "modelTurnAcknowledged": {
                "const": false
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "version",
        "messageType",
        "commandId",
        "idempotencyKey",
        "requestedAt",
        "expiresAt",
        "capabilityScope",
        "action",
        "actionDigest",
        "identity",
        "expectedRevisions",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "version": {
          "const": "piagent-webui-control-v1"
        },
        "messageType": {
          "const": "command"
        },
        "commandId": {
          "$ref": "common-v1.schema.json#/$defs/opaqueRef"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._~-]+$"
        },
        "requestedAt": {
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "expiresAt": {
          "$ref": "common-v1.schema.json#/$defs/timestamp"
        },
        "capabilityScope": {
          "$ref": "#/$defs/capabilityScope"
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "actionDigest": {
          "$ref": "common-v1.schema.json#/$defs/digest"
        },
        "identity": {
          "$ref": "common-v1.schema.json#/$defs/identity"
        },
        "expectedRevisions": {
          "$ref": "#/$defs/expectedRevisions"
        },
        "payload": {
          "type": "object",
          "maxProperties": 6
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/commandActionBindings"
        }
      ]
    },
    "commandActionBindings": {
      "allOf": [
        {
          "if": {
            "properties": {
              "action": {
                "const": "chat.send"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.chat"
              },
              "payload": {
                "$ref": "#/$defs/messageContent"
              },
              "expectedRevisions": {
                "properties": {
                  "queueRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "queue.update"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.chat"
              },
              "payload": {
                "$ref": "#/$defs/queueUpdatePayload"
              },
              "expectedRevisions": {
                "properties": {
                  "queueRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "queue.delete"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.chat"
              },
              "payload": {
                "$ref": "#/$defs/queueDeletePayload"
              },
              "expectedRevisions": {
                "properties": {
                  "queueRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "queue.dispatch"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.chat"
              },
              "payload": {
                "$ref": "#/$defs/queueDispatchPayload"
              },
              "expectedRevisions": {
                "properties": {
                  "queueRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "lifecycle.stop"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.lifecycle"
              },
              "payload": {
                "$ref": "#/$defs/stopPayload"
              },
              "identity": {
                "properties": {
                  "agentOperationId": {
                    "$ref": "common-v1.schema.json#/$defs/opaqueRef"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "lifecycle.pause"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.lifecycle"
              },
              "payload": {
                "$ref": "#/$defs/pausePayload"
              },
              "identity": {
                "properties": {
                  "taskId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  },
                  "taskRunId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  }
                },
                "type": "object"
              },
              "expectedRevisions": {
                "properties": {
                  "taskRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "controlRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "lifecycle.resume"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.lifecycle"
              },
              "payload": {
                "$ref": "#/$defs/emptyPayload"
              },
              "identity": {
                "properties": {
                  "taskId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  },
                  "taskRunId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  }
                },
                "type": "object"
              },
              "expectedRevisions": {
                "properties": {
                  "taskRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "controlRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "lifecycle.resume-and-continue"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.resumeAndContinue"
              },
              "payload": {
                "$ref": "#/$defs/messageContent",
                "properties": {
                  "delivery": {
                    "const": "new-operation"
                  }
                },
                "type": "object"
              },
              "identity": {
                "properties": {
                  "taskId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  },
                  "taskRunId": {
                    "$ref": "common-v1.schema.json#/$defs/publicId"
                  }
                },
                "type": "object"
              },
              "expectedRevisions": {
                "properties": {
                  "taskRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "controlRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "queueRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "session-options.set-model"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.sessionOptions"
              },
              "payload": {
                "$ref": "#/$defs/modelPayload"
              },
              "expectedRevisions": {
                "properties": {
                  "sessionOptionRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "session-options.set-thinking"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "control.sessionOptions"
              },
              "payload": {
                "$ref": "#/$defs/thinkingPayload"
              },
              "expectedRevisions": {
                "properties": {
                  "sessionOptionRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "const": "review.mark"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "reviewActions"
              },
              "payload": {
                "$ref": "#/$defs/reviewMarkPayload"
              },
              "expectedRevisions": {
                "properties": {
                  "taskRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "workspaceRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "patchPreimage": {
                    "$ref": "common-v1.schema.json#/$defs/digest"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "source.stage",
                  "source.unstage"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "capabilityScope": {
                "const": "reviewActions"
              },
              "payload": {
                "$ref": "#/$defs/sourceMutationPayload"
              },
              "expectedRevisions": {
                "properties": {
                  "taskRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "workspaceRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "indexRevision": {
                    "$ref": "common-v1.schema.json#/$defs/revisionToken"
                  },
                  "workspacePreimage": {
                    "$ref": "common-v1.schema.json#/$defs/workingTreeDigest"
                  },
                  "indexPreimage": {
