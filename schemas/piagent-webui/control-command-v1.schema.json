            "type": "object",
            "properties": {
              "identity": {
                "type": "object",
                "properties": {
                  "agentOperationId": { "$ref": "common-v1.schema.json#/$defs/opaqueRef" }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "lifecycle.pause",
                  "lifecycle.resume",
                  "lifecycle.resume-and-continue",
                  "review.mark",
                  "source.stage",
                  "source.unstage",
                  "source.revert",
                  "source.open-in-vscode",
                  "commit-summary.generate"
                ]
              }
            },
            "required": ["action"]
          },
          "then": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "object",
                "properties": {
                  "taskId": { "$ref": "common-v1.schema.json#/$defs/publicId" },
                  "taskRunId": { "$ref": "common-v1.schema.json#/$defs/publicId" }
