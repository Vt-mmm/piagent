      "allOf": [
        {
          "$ref": "#/$defs/receiptActionResultBinding"
        },
        {
          "$ref": "#/$defs/receiptPhaseResultBinding"
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "action": { "const": "lifecycle.stop" }
