{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vt-mmm/piagent/schemas/project-profile.schema.json",
  "title": "Pi Agent Project Profile",
  "type": "object",
  "required": [
    "schemaVersion",
    "projectId",
    "displayName"
  ],
  "if": {
    "required": [
      "extends"
    ]
  },
  "then": {
    "description": "A profile that names an adapter stores identity plus overrides. Every policy field it omits comes from the installed adapter at runtime, so none of them are required here."
  },
  "else": {
    "required": [
      "mode",
      "rootMarkers",
      "protectedPaths",
      "requiredContext",
      "verifyCommands",
      "mcpCapabilities"
    ]
  },
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "extends": {
      "description": "Name of a built-in adapter under adapters/ in the installed platform. Its profile is the base; every other key in this file replaces the adapter's key of the same name.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "permissionProfile": {
      "description": "Runtime permission profile. workspace-write is the default; trusted-full-access still keeps Piagent protected-path and destructive/external confirmation gates.",
      "enum": [
        "read-only",
        "workspace-write",
        "trusted-full-access"
      ]
    },
    "rootMarkers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shellProtectedPaths": {
      "type": "array",
      "description": "Optional bash-specific protected path globs. These block shell access only, not path-tool read/write. If omitted, project protectedPaths also apply to bash path extraction. If provided for legacy profiles, keep write-sensitive paths in protectedPaths or readOnlyPaths as well.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "readOnlyPaths": {
      "type": "array",
      "description": "Paths that may be inspected with read/grep/find/ls but must not be modified; shell access is blocked automatically for these paths.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "additionalReadRoots": {
      "type": "array",
      "description": "Directories outside the project that piagent_document_read may read documents from. Read-only, document extensions only, and protectedPaths still win.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredContext": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "taskModes": {
      "type": "object"
    },
    "verifyCommands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "minItems": 1
      }
    },
    "mcpCapabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capabilityPacks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
          }
        }
      }
    },
    "capabilitySources": {
      "description": "Directories outside the platform that provide capability packs. Each source declares exactly one of path (a directory inside this project) or source (an exact npm or git release vendored into .pi/capability-vendor). Declaring a source does not grant anything: its packs still have to pass capabilityPolicy.",
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "oneOf": [
          {
            "required": [
              "path"
            ]
          },
          {
            "required": [
              "source"
            ]
          }
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:npm|git):"
          }
        }
      }
    },
    "capabilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedOwners",
        "allowedLifecycles",
        "allowedFilesystemRead",
        "allowedFilesystemWrite",
        "allowedNetworkDomains",
        "allowedExternalActions"
      ],
      "properties": {
        "allowedOwners": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          }
        },
        "allowedLifecycles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "experimental",
              "stable",
              "deprecated"
            ]
          }
        },
        "allowedFilesystemRead": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allowedFilesystemWrite": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "allowedNetworkDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:\\*\\.)?[a-z0-9](?:[a-z0-9.-]{0,251}[a-z0-9])?$"
          }
        },
        "allowedExternalActions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "git-push",
              "github-pull-request",
              "github-issue",
              "release",
              "publish",
              "deploy",
              "database-change",
              "external-provider-write"
            ]
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "off",
            "manual",
            "assisted",
            "external-package"
          ]
        },
        "scope": {
          "enum": [
            "project",
            "global",
            "hybrid"
          ]
        },
        "summaryFile": {
          "type": "string",
          "minLength": 1
        },
        "handbookFile": {
          "type": "string",
          "minLength": 1
        },
        "localDir": {
          "type": "string",
          "minLength": 1
        },
        "readBeforeTask": {
          "type": "boolean"
        },
        "writePolicy": {
          "enum": [
            "explicit-only",
            "task-trace",
            "session-summary"
          ]
        },
        "maxInjectedChars": {
          "type": "integer",
          "minimum": 0
        },
        "externalPackages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "contextIndex": {
      "type": "object",
      "description": "Compact advisory project context index. This is not a security boundary or source of truth; it helps agents navigate profile/project/tech/task context with citations.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "writePolicy": {
          "enum": [
            "onboarding-record",
            "approved-workflow",
            "off"
          ]
        },
        "requireCitations": {
          "type": "boolean"
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "includeTechStack": {
          "type": "boolean"
        },
        "includeMemoryPointers": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "description": "Solo-first orchestration policy for subagent usage, review lenses, model-role guidance, and Field Guide memory.",
      "properties": {
        "defaultMode": {
          "enum": [
            "solo-first",
            "bounded-subagents",
            "parallel-readonly"
          ]
        },
        "maxConcurrentSubagents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "defaultReviewLenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "correctness",
              "tests",
              "scope",
              "security",
              "docs",
              "release",
              "package"
            ]
          }
        },
        "roleModelGuidance": {
          "type": "object",
          "properties": {
            "planner": {
              "type": "string",
              "minLength": 1
            },
            "worker": {
              "type": "string",
              "minLength": 1
            },
            "reviewer": {
              "type": "string",
              "minLength": 1
            },
            "watchdog": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "fieldGuide": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "maxLines": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "writePolicy": {
              "enum": [
                "explicit-only",
                "approved-workflow"
              ]
            },
            "readBeforeTask": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "techStack": {
      "type": "object",
      "description": "Selected project tech stack, stored as a Context7-ready manifest and concise per-tech snapshots.",
      "properties": {
        "provider": {
          "enum": [
            "context7"
          ]
        },
        "manifest": {
          "type": "string",
          "minLength": 1
        },
        "contextDir": {
          "type": "string",
          "minLength": 1
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "object",
          "properties": {
            "frontend": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "backend": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "database": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "mobile": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "devops": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "docs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "runtime": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "runtimePolicy": {
      "type": "object",
      "properties": {
        "execPolicy": {
          "enum": [
            "off",
            "advisory",
            "enforce"
          ]
        },
        "contextBudget": {
          "enum": [
            "off",
            "advisory",
            "enforce"
          ]
        },
        "toolRegistry": {
          "enum": [
            "off",
            "advisory",
            "enforce"
          ]
        },
        "finalGate": {
          "enum": [
            "off",
            "advisory",
            "enforce"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
