{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vt-mmm/piagent/schemas/task-contract.schema.json",
  "title": "Pi Agent Task Implementation Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskRunId",
    "taskId",
    "sessionId",
    "changeMode",
    "attempt",
    "maxAttempts",
    "previousAttempts",
    "summary",
    "riskLane",
    "expectedOutput",
    "acceptanceCriteria",
    "scope",
    "outOfScope",
    "protectedPaths",
    "requiredContext",
    "contextManifest",
    "memoryCitations",
    "mcpCapabilities",
    "verifyCommands",
    "workPlan",
    "reviewLenses",
    "baselineChangedFiles",
    "baselineFileDigests",
    "observedChangedFiles",
    "finalWorkingTreeFiles",
    "finalFileDigests",
    "changedFiles",
    "verifyEvidence",
    "trace",
    "createdAt",
    "updatedAt"
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "citation": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "fileDigests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "taskRunId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "sessionId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "sessionName": {
      "type": "string"
    },
    "changeMode": {
      "enum": [
        "source-change",
        "read-only"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "previousAttempts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "taskRunId",
          "attempt",
          "outcome",
          "recordedAt"
        ],
        "properties": {
          "taskRunId": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "outcome": {
            "enum": [
              "pending",
              "completed",
              "blocked",
              "partial",
              "failed"
            ]
          },
          "failedAt": {
            "enum": [
              "research",
              "plan",
              "execute",
              "verify",
              "review"
            ]
          },
          "reason": {
            "type": "string"
          },
          "ruledOut": {
            "type": "string"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "riskLane": {
      "enum": [
        "tiny",
        "normal",
        "high-risk"
      ]
    },
    "intakeMode": {
      "enum": [
        "model",
        "runtime"
      ]
    },
    "expectedOutput": {
      "type": "string",
      "minLength": 10
    },
    "acceptanceCriteria": {
      "allOf": [
        {
          "$ref": "#/$defs/stringList"
        },
        {
          "minItems": 1
        }
      ]
    },
    "scope": {
      "allOf": [
        {
          "$ref": "#/$defs/stringList"
        },
        {
          "minItems": 1
        }
      ]
    },
    "outOfScope": {
      "$ref": "#/$defs/stringList"
    },
    "protectedPaths": {
      "$ref": "#/$defs/stringList"
    },
    "requiredContext": {
      "$ref": "#/$defs/stringList"
    },
    "contextManifest": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "memoryCitations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "mcpCapabilities": {
      "$ref": "#/$defs/stringList"
    },
    "verifyGroup": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "verifyCommands": {
      "$ref": "#/$defs/stringList"
    },
    "workPlan": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "role",
          "mode",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "role": {
            "enum": [
              "parent",
              "piagent-scout",
              "piagent-planner",
              "piagent-worker",
              "piagent-reviewer",
              "piagent-oracle"
            ]
          },
          "mode": {
            "enum": [
              "read-only",
              "single-writer",
              "review"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in-progress",
              "done",
              "skipped",
              "failed"
            ]
          },
          "dependsOn": {
            "$ref": "#/$defs/stringList"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "reviewLenses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "correctness",
          "tests",
          "scope",
          "security",
          "docs",
          "release",
          "package"
        ]
      }
    },
    "orchestration": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "solo-first",
            "bounded-subagents",
            "parallel-readonly"
          ]
        },
        "subagents": {
          "enum": [
            "not-used",
            "optional",
            "used"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fieldGuidePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "modelRoles": {
          "type": "object",
          "properties": {
            "planner": {
              "type": "string"
            },
            "worker": {
              "type": "string"
            },
            "reviewer": {
              "type": "string"
            },
            "watchdog": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "baselineChangedFiles": {
      "$ref": "#/$defs/stringList"
    },
    "baselineFileDigests": {
      "$ref": "#/$defs/fileDigests"
    },
    "observedChangedFiles": {
      "$ref": "#/$defs/stringList"
    },
    "finalWorkingTreeFiles": {
      "$ref": "#/$defs/stringList"
    },
    "finalFileDigests": {
      "$ref": "#/$defs/fileDigests"
    },
    "changedFiles": {
      "$ref": "#/$defs/stringList"
    },
    "verifyEvidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode",
          "summary",
          "recordedAt"
        ],
        "properties": {
          "command": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "exitCode": {
            "type": "integer"
          },
          "summary": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "observed": {
            "type": "boolean"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "isError": {
            "type": "boolean"
          },
          "matchedProfileCommand": {
            "type": "boolean"
          },
          "workingTreeDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "outcome"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "pending",
            "completed",
            "blocked",
            "partial",
            "failed"
          ]
        },
        "friction": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "recordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "failedAt": {
      "enum": [
        "research",
        "plan",
        "execute",
        "verify",
        "review"
      ]
    },
    "failureReason": {
      "type": "string"
    },
    "ruledOut": {
      "type": "string"
    },
    "migratedFromSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
