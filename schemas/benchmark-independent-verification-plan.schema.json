{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://piagent.dev/schemas/benchmark-independent-verification-plan.schema.json",
  "title": "Operator-reviewed benchmark independent verification catalog (not authority)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "suiteDigest", "verifierDigest", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "benchmark-independent-verification-plan-v1" },
    "suiteDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "verifierDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scenarios": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scenarioId", "plans"],
        "properties": {
          "scenarioId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$" },
          "plans": { "type": "array", "minItems": 1, "maxItems": 32,
            "items": { "$ref": "approved-host-contracts.schema.json#/$defs/plan" } }
        }
      }
    }
  }
}
