            "properties": {
              "id": {"type": "string","pattern": "^[a-z][a-z0-9._-]{0,63}$"},
              "mode": {"enum": ["frozen","current","protected"]},
              "relativePath": {"type": "string","minLength": 1,"maxLength": 1024,
                "pattern": "^(?!/)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.git|\\.pi|node_modules)(?:/|$))[^\\\\\u0000-\u001f:%?#]+$"},
              "sha256": {"oneOf": [{"$ref": "#/$defs/hash"},{"type": "null"}]}
            },
            "allOf": [
              {"if": {"properties": {"mode": {"const": "frozen"}}},"then": {"properties": {"sha256": {"$ref": "#/$defs/hash"}}}},
              {"if": {"properties": {"mode": {"enum": ["current","protected"]}}},"then": {"properties": {"sha256": {"type": "null"}}}}
            ]
          }
        }
      }
    },
    "compositeContractV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route","criterionId","criterionHash","maxAttempts","planContext"],
      "properties": {
