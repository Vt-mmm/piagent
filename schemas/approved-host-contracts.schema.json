            "properties": {"id": {"$ref": "#/$defs/id"},"cases": {"type": "array","minItems": 1,"maxItems": 256,"items": {"$ref": "#/$defs/caseV2"}}}
          }
        },
        "route": {"const": "code"}
      }
    },
    "compositePlanContextV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version","contractText","declarationsText","identity","materialBindings"],
      "properties": {
        "version": {"const": "composite-plan-context-v1"},
        "contractText": {"type": "string","minLength": 1,"maxLength": 1048576},
        "declarationsText": {"type": "string","minLength": 1,"maxLength": 1048576},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["suiteDigest","configDigest","armDigest"],
          "properties": {
            "suiteDigest": {"$ref": "#/$defs/hash"},
            "configDigest": {"$ref": "#/$defs/hash"},
            "armDigest": {"$ref": "#/$defs/hash"}
          }
        },
        "materialBindings": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
